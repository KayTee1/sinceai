# Copy to .env.local and fill in. Never commit real keys.
ANTHROPIC_API_KEY=
# Optional: SQLite file built by `npm run db:import` (default data/private/steward.db)
DATABASE_FILE=
# Optional (T24): 1 lets the demo "manager" run / dismiss / abandon scheduler jobs over HTTP.
# Not authentication; leave empty unless you accept the demo trust model.
SCHEDULER_DEMO_ACTIONS=
